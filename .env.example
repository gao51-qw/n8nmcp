# Local development environment for `npm run dev`.
# Copy to `.env` and fill in values. `.env` is git-ignored; never commit it.
# Production values live in deploy/.env.app (see deploy/.env.app.example).

# Supabase project (public values). next.config.ts exposes these to the
# browser as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# when the NEXT_PUBLIC_ variants are not set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets needed for dashboard and MCP routes.
# SUPABASE_SERVICE_ROLE_KEY=
# APP_ENCRYPTION_KEY=   # 32 random bytes: openssl rand -base64 32

# Optional: surface URLs. `next dev` defaults all four to http://localhost:3000.
# NEXT_PUBLIC_MCP_SITE_URL=
# NEXT_PUBLIC_DOCS_URL=
# NEXT_PUBLIC_BLOG_URL=
# NEXT_PUBLIC_DASHBOARD_URL=

# Optional: OAuth 2.1 for MCP clients (see deploy/.env.app.example). Off by default.
# MCP_OAUTH_ENABLED=1

# Optional: Paddle billing (dashboard /billing checkout and webhook). Billing is
# hidden unless PADDLE_API_KEY, PADDLE_CLIENT_TOKEN (test_... for sandbox,
# live_... for production) and PADDLE_PRICE_PRO are all set and match PADDLE_ENV.
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=            # server-only secret
# PADDLE_CLIENT_TOKEN=       # public Paddle.js token
# PADDLE_WEBHOOK_SECRET=     # server-only secret
# PADDLE_PRICE_PRO=
# PADDLE_PRICE_ENTERPRISE=
# Signs the checkout customData binding ({ user_id, ts, sig }) that the Paddle
# webhook requires before it binds a new subscription to a user. Checkout stays
# disabled until this is set. Server-only secret; use a dedicated value of at
# least 32 characters, never PADDLE_WEBHOOK_SECRET or PADDLE_API_KEY. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# BILLING_CUSTOM_DATA_SECRET=
