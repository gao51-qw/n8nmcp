# Copy to .env.app on the VPS — runtime secrets for the main app container.
# DO NOT commit. Fill these from your production secret manager.

NODE_ENV=production

# ─── Public split-domain URLs ──────────────────────────────────────────────
NEXT_PUBLIC_MCP_SITE_URL=https://mcp.n8nworkflow.com
NEXT_PUBLIC_MCP_ENDPOINT_URL=https://mcp.n8nworkflow.com/mcp
NEXT_PUBLIC_DOCS_URL=https://docs.n8nworkflow.com
NEXT_PUBLIC_BLOG_URL=https://blog.n8nworkflow.com
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.n8nworkflow.com
NEXT_PUBLIC_SECURITY_EMAIL=server@n8nworkflow.com

# Optional social URLs used in SEO metadata.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# Server-side copies used by /api/auth/* (sign-in, refresh, sign-out). They
# issue the HttpOnly session cookies (n8nmcp-rt on Path=/api/auth and the
# n8nmcp-session marker) on the parent domain shared by the four hosts above.
# Supabase Auth must allow https://<dashboard host>/auth/callback and
# https://<dashboard host>/reset-password as redirect URLs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...      # server-only, never expose

# ─── Encryption (REQUIRED in production) ───────────────────────────────────
# 32-byte master key for AES-256-GCM (encrypts user n8n API keys at rest).
# Generate ONCE with:  openssl rand -base64 32
# DO NOT change after first run — would invalidate every stored ciphertext.
# DO NOT lose — back up to your password manager. Without it the app can no
# longer decrypt n8n credentials and users must re-enter them all.
APP_ENCRYPTION_KEY=

# ─── Paddle billing (required if you enable paid tiers) ────────────────────
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_ENTERPRISE=
# Signs the single-use checkout user binding (v2: user_id, ts, nonce) the
# webhook trusts. Required for checkout:
# at least 32 characters and different from the Paddle secrets. Generate with
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BILLING_CUSTOM_DATA_SECRET=

# Bearer token used only by VPS cron and operators for the internal billing
# endpoints: POST /api/internal/billing/sync-subscriptions (reconciliation) and
# POST /api/internal/billing/audit-bindings (read-only binding audit).
BILLING_CRON_SECRET=

# ─── Upstream n8n knowledge MCP container ──────────────────────────────────
# Operator-owned server configuration. Compose pins the same values on every app
# deployment so requests cannot redirect this trust exception at runtime.
# End users connect to the app gateway, never directly to this container.
UPSTREAM_N8N_MCP_URL=http://mcp:3000/mcp
UPSTREAM_N8N_MCP_TOKEN=same-as-MCP_AUTH_TOKEN-in-.env
ENABLE_MULTI_TENANT=true

# ─── OAuth 2.1 for MCP clients (roadmap Phase 2) ───────────────────────────
# Supabase Auth's OAuth 2.1 Server is the authorization server. Turn this on
# only after the Supabase project has: Authentication → OAuth Server enabled,
# dynamic client registration on, an asymmetric (ES256/RS256) signing key, and
# the authorization path set to /oauth/consent on the dashboard Site URL.
# Then run migration 20261104120000_oauth_grants.sql before enabling.
MCP_OAUTH_ENABLED=0
# Optional overrides. The issuer defaults to $SUPABASE_URL/auth/v1.
# MCP_OAUTH_ISSUER=
# Set only if a Custom Access Token Hook narrows `aud` for OAuth tokens.
# MCP_OAUTH_AUDIENCE=

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Recommended in multi-container production; leave blank only for local dev.
RATE_LIMITER=supabase
MCP_SHORT_WINDOW_LIMITER=supabase
# Where MCP confirmations and request-state nonces live between requests.
# Required as soon as more than one app replica runs (see DEPLOY.md).
MCP_SHARED_STATE=supabase

# ─── Logging ───────────────────────────────────────────────────────────────
# json (default in prod) | pretty (dev only)
LOG_FORMAT=json
LOG_LEVEL=info

# ─── Content-Security-Policy ───────────────────────────────────────────────
# The app sets a nonce-based CSP on every page; aaPanel nginx adds none.
# enforce (default) | report (emergency switch: Report-Only header)
CSP_MODE=enforce
# Optional http(s) URL sent as report-uri, e.g. a Sentry security endpoint.
CSP_REPORT_URI=

# ─── Client IP ─────────────────────────────────────────────────────────────
# Set to true only when Cloudflare is in front of nginx and the origin accepts
# Cloudflare traffic only; otherwise CF-Connecting-IP is client-controlled.
TRUST_CLOUDFLARE_HEADERS=

# ─── Support observability ─────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN is safe for the browser; all remaining values are
# server/build secrets and must not be exposed through NEXT_PUBLIC_*.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Applies to the server and edge runtimes at start-up. The browser rate is
# inlined when the image is built: pass this variable (or
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE) to the build, else the browser uses 0.05.
SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── Support email and automation ──────────────────────────────────────────
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=server@n8nworkflow.com
SUPPORT_N8N_WEBHOOK_URL=
SUPPORT_N8N_WEBHOOK_SECRET=

# Bearer token used only by VPS cron for internal support maintenance routes.
SUPPORT_CRON_SECRET=
