(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"

		# Content Security Policy
		#
		# Supabase session tokens live in browser storage, so script injection
		# means account takeover. Two headers are sent:
		#
		# 1. Content-Security-Policy (enforced): directives that cannot break the
		#    app (no plugins, no <base> hijack, forms post only to this origin,
		#    never framed).
		# 2. Content-Security-Policy-Report-Only: the full policy. Paddle.js
		#    checkout is being added and its exact hosts are not yet confirmed in
		#    production, so the full policy reports first instead of blocking.
		#
		# script-src keeps 'unsafe-inline': the App Router streams per-page inline
		# scripts (self.__next_f.push(...)) and next/script beforeInteractive wraps
		# the theme script in self.__next_s.push(...), so hashes cannot cover
		# them, and a browser ignores 'unsafe-inline' once any hash or nonce is
		# listed. A nonce would need the proxy to mint one per request and would
		# force dynamic rendering of every page. External script origins stay
		# limited to this origin and Paddle, and 'unsafe-eval' is not allowed.
		# For reference, sha256 of the raw theme script in src/app/layout.tsx is
		# 488pTIi5V3jje85EbyVK7bnq1wuW2/vX1m2BzH6myfk= (recompute whenever that
		# script changes, if a nonce/hash policy is adopted later).
		#
		# Environment (substituted when Caddy loads this file):
		#   CSP_SUPABASE_HOST     Supabase API host, default *.supabase.co; set it
		#                         to the project host (or a self-hosted Supabase
		#                         domain) to tighten connect-src and img-src.
		#   CSP_REPORT_DIRECTIVE  optional, e.g. "report-uri https://<org>.ingest.sentry.io/api/<project>/security/?sentry_key=<public key>"
		#                         so violations reach Sentry.
		#
		# To enforce: once the report-only policy has run clean through sign-in,
		# dashboard, avatar upload, agent console and a Paddle sandbox checkout,
		# rename Content-Security-Policy-Report-Only to Content-Security-Policy
		# (replacing the baseline line) and reload Caddy.
		Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://cdn.paddle.com; img-src 'self' data: blob: https://{$CSP_SUPABASE_HOST:*.supabase.co} https://*.paddle.com; font-src 'self' data:; connect-src 'self' https://{$CSP_SUPABASE_HOST:*.supabase.co} wss://{$CSP_SUPABASE_HOST:*.supabase.co} https://*.sentry.io https://*.paddle.com; frame-src https://*.paddle.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; {$CSP_REPORT_DIRECTIVE}"
	}
}

(next_app) {
	encode zstd gzip
	request_body {
		max_size 25MB
	}

	import security_headers

	reverse_proxy app:3001 {
		flush_interval -1
	}
}

{$MCP_DOMAIN:mcp.n8nworkflow.com} {
	import next_app
}

{$DOCS_DOMAIN:docs.n8nworkflow.com} {
	import next_app
}

{$BLOG_DOMAIN:blog.n8nworkflow.com} {
	import next_app
}

{$DASHBOARD_DOMAIN:dashboard.n8nworkflow.com} {
	import next_app
}
